datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int     @id @default(autoincrement())
  name              String? @db.VarChar(255)
  email             String? @unique @db.VarChar(255)
  password          String? @db.VarChar(100)
  phone             String? @db.VarChar(11)
  cpf               String? @db.VarChar(11)
  address           String? @db.VarChar(255)
  complementAddress String  @db.VarChar(255)
  carts             Cart[]
  orders            Order[]

  @@map("users")
}

model Admin {
  id       Int     @id @default(autoincrement())
  name     String? @db.VarChar(255)
  email    String? @unique
  password String? @db.VarChar(255)

  @@map("admins")
}

model Product {
  id    Int     @id @default(autoincrement())
  name  String? @db.VarChar(255)
  price Decimal @db.Decimal(10, 2)
  image String? @db.VarChar(255)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model Cart {
  id     Int        @id @default(autoincrement())
  userId Int
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              Int                  @id @default(autoincrement())
  userId          Int
  paymentMethodId Int
  deliveryManId   Int?
  statusId        Int
  orderDate       DateTime             @default(now())
  orderNote       String?              @db.VarChar(255)
  deliveryTime    DateTime?
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  deliveryMan     DeliveryMan?         @relation(fields: [deliveryManId], references: [id], onDelete: SetNull)
  status          OrderStatus          @relation(fields: [statusId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]

  @@index([userId])
  @@index([statusId])
  @@index([paymentMethodId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatus {
  id         Int                  @id @default(autoincrement())
  statusName String               @db.VarChar(100)
  orders     Order[]
  history    OrderStatusHistory[]

  @@map("order_status")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  statusId  Int
  changedAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([statusId])
  @@map("order_status_history")
}

model PaymentMethod {
  id         Int     @id @default(autoincrement())
  methodName String  @db.VarChar(100)
  orders     Order[]

  @@map("payment_methods")
}

model DeliveryMan {
  id       Int     @id @default(autoincrement())
  name     String? @db.VarChar(255)
  email    String? @unique @db.VarChar(255)
  password String? @db.VarChar(255)
  orders   Order[]

  @@map("deliveryMans")
}
