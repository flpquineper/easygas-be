datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int     @id @default(autoincrement())
  name              String  
  email             String  @unique 
  password          String  
  phone             String  @unique 
  cpf               String  @unique 
  address           String  
  complementAddress String? 
  carts             Cart[]
  orders            Order[]

  @@map("users")
}

model Admin {
  id       Int     @id @default(autoincrement())
  name     String  
  email    String  @unique
  password String  

  @@map("admins")
}

model Product {
  id    Int     @id @default(autoincrement())
  name  String  
  price Decimal
  image String? 

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("products")
}

model Cart {
  id     Int    @id @default(autoincrement())
  userId Int?   @unique
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  productId Int
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([productId])
  @@unique([cartId, productId]) 
  @@map("cart_items")
}

model Order {
  id              Int                  @id @default(autoincrement())
  userId          Int
  paymentMethodId Int
  deliveryManId   Int?
  statusId        Int
  orderDate       DateTime             @default(now())
  orderNote       String?              
  deliveryTime    DateTime?
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod        @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  deliveryMan     DeliveryMan?         @relation(fields: [deliveryManId], references: [id], onDelete: SetNull)
  status          OrderStatus          @relation(fields: [statusId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]

  @@index([userId])
  @@index([statusId])
  @@index([paymentMethodId])
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal 
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatus {
  id         Int  @id @default(autoincrement())
  statusName String              
  orders     Order[]
  history    OrderStatusHistory[]

  @@map("order_status")
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  statusId  Int
  changedAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([statusId])
  @@map("order_status_history")
}

model PaymentMethod {
  id         Int     @id @default(autoincrement())
  methodName String  
  orders     Order[]

  @@map("payment_methods")
}

model DeliveryMan {
  id       Int     @id @default(autoincrement())
  name     String? 
  email    String? @unique 
  password String? 
  orders   Order[]

  @@map("deliveryMans")
}
